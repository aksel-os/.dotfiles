{
  services.aerospace = {
    enable = true;
    settings = {
      mode.main.binding = {
        alt-h = "focus left";
        alt-j = "focus down";
        alt-k = "focus up";
        alt-l = "focus right";

        alt-shift-h = "move left";
        alt-shift-j = "move down";
        alt-shift-k = "move up";
        alt-shift-l = "move right";

        alt-ctrl-h = "join-with left";
        alt-ctrl-j = "join-with down";
        alt-ctrl-k = "join-with up";
        alt-ctrl-l = "join-with right";

        alt-cmd-h = "resize width -60";
        alt-cmd-j = "resize height +60";
        alt-cmd-k = "resize height -60";
        alt-cmd-l = "resize width +60";

        alt-ctrl-cmd-h = "move-workspace-to-monitor left";
        alt-ctrl-cmd-j = "move-workspace-to-monitor down";
        alt-ctrl-cmd-k = "move-workspace-to-monitor up";
        alt-ctrl-cmd-l = "move-workspace-to-monitor right";

        alt-cmd-1 = "summon-workspace 1";
        alt-cmd-2 = "summon-workspace 2";
        alt-cmd-3 = "summon-workspace 3";
        alt-cmd-4 = "summon-workspace 4";
        alt-cmd-5 = "summon-workspace 5";
        alt-cmd-6 = "summon-workspace 6";

        alt-1 = "workspace 1";
        alt-2 = "workspace 2";
        alt-3 = "workspace 3";
        alt-4 = "workspace 4";
        alt-5 = "workspace 5";
        alt-6 = "workspace 6";

        alt-shift-1 = "move-node-to-workspace 1";
        alt-shift-2 = "move-node-to-workspace 2";
        alt-shift-3 = "move-node-to-workspace 3";
        alt-shift-4 = "move-node-to-workspace 4";
        alt-shift-5 = "move-node-to-workspace 5";
        alt-shift-6 = "move-node-to-workspace 6";
      };
    };
  };
}
